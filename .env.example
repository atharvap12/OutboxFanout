# ============================================================================
# OutboxFanout — environment template
#
# Copy to .env and fill in:   cp .env.example .env
# Load into your shell:       set -a; source .env; set +a
#
# ----------------------------------------------------------------------------
# READ THIS FIRST: almost everything here is OPTIONAL.
#
# shared/config.py has a sensible default for every variable except
# PG_PASSWORD. This file lists them all so they are DISCOVERABLE — so you can
# see what knobs exist without reading the source — not because you must set
# them. Delete any line you are happy to leave at its default; the shown value
# IS the default unless marked otherwise.
#
# ----------------------------------------------------------------------------
# THREE DIFFERENT CONSUMERS read from around here. Do not confuse them:
#
#   1. Your SHELL          — only after `set -a; source .env; set +a`.
#                            Used by curl/psql/aws commands you type.
#   2. Docker Compose      — automatically, to substitute ${VAR} inside
#                            docker-compose.yml. Never reaches your shell.
#   3. Python in a container — does NOT read this file at all. It sees only
#                            what docker-compose.yml lists under
#                            `environment:` for that service.
#
# That third point is why the HOST defaults below say "localhost" while
# compose overrides them to service names. See the PG_HOST note.
# ============================================================================


# ============================================================================
# REQUIRED — no default exists, the app refuses to start without it
# ============================================================================

# Postgres password. Must match what the postgres container was CREATED with.
# Changing it later does nothing until `docker compose down -v`, because the
# official image only applies POSTGRES_* on a first run with an empty volume.
PG_PASSWORD=mypassword


# ============================================================================
# POSTGRES
# ============================================================================

# IMPORTANT — the two-addresses rule.
# Leave this as localhost. It is the address for YOU, running scripts on your
# laptop. docker-compose.yml overrides it to `postgres` for containers,
# because inside a container "localhost" means that container, not your
# machine. Setting this to `postgres` here would break your host-side tools.
PG_HOST=localhost
PG_PORT=5432

PG_USER=myuser
PG_DB=mydatabase

# Optional full-URL override. If set, it wins over all of the above.
# Handy for pointing at a completely different database without touching the
# individual parts. Leave commented out for normal use.
# DATABASE_URL=postgresql+psycopg://myuser:mypassword@localhost:5432/mydatabase

# Print every SQL statement SQLAlchemy sends.
# Turn on to watch both INSERTs land between one BEGIN and one COMMIT — the
# atomic write, made visible. Very noisy; leave off by default.
SQL_ECHO=0


# ============================================================================
# REDIS  (Notifications consumer — Phase 5)
# ============================================================================

# Same two-addresses rule: localhost for you, `redis` for containers.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional full-URL override, same idea as DATABASE_URL.
# REDIS_URL=redis://localhost:6379/0

# How long a "processed:{order_id}" dedup marker lives. 48 hours.
#
# This encodes a bet: a redelivery arriving LATER than this is treated as new,
# and would send a duplicate email. SQS retention defaults to 4 days (max 14),
# so it is possible, just unlikely. Note the asymmetry — the Postgres
# consumers dedupe forever, because a row has no TTL.
NOTIFY_DEDUP_TTL_SECONDS=172800


# ============================================================================
# AWS / LOCALSTACK
# ============================================================================

# The single "edge port" that fronts every emulated AWS API. There is no
# separate SNS port and SQS port.
#
# AWS_ENDPOINT_URL is the AWS SDKs' OWN standard variable name, so boto3 and
# the AWS CLI both honour it automatically — once this is exported,
# `aws sqs list-queues` works with no --endpoint-url flag.
#
# Containers override this to http://localstack:4566.
# Delete this line entirely and the same code talks to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566

AWS_DEFAULT_REGION=us-east-1

# LocalStack ignores the VALUES, but boto3 and the CLI sign every request with
# SigV4 before sending, and signing needs a key. Without these the request
# never leaves your machine. Any non-empty string works.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test


# ============================================================================
# RESOURCE NAMES  (Phases 2-3)
#
# Names, not ARNs or URLs. LocalStack's free tier forgets every topic and
# queue on restart, so the identifiers change — but the NAMES are stable, and
# everything is resolved from them at runtime.
# ============================================================================

SNS_TOPIC_NAME=order-events

BILLING_QUEUE_NAME=billing-queue
SHIPPING_QUEUE_NAME=shipping-queue
NOTIFY_QUEUE_NAME=notify-queue


# ============================================================================
# RELAY  (Phase 2)
# ============================================================================

# How often the relay checks the outbox for unpublished rows.
RELAY_POLL_INTERVAL_SECONDS=2

# How many rows to claim per poll. Bigger = fewer round trips, but a crash
# mid-batch means more rows get republished.
RELAY_BATCH_SIZE=10


# ============================================================================
# SQS CONSUMERS  (Phases 4-5)
# ============================================================================

# Long polling: wait up to this many seconds for a message instead of
# returning empty immediately. 20 is the SQS maximum and the sane default —
# far fewer API calls AND lower latency than a sleep-and-retry loop.
SQS_WAIT_TIME_SECONDS=20

# Messages per receive call. 10 is the SQS maximum.
SQS_MAX_MESSAGES=10

# How long a received message stays hidden from other consumers while you work
# on it. Set this very LOW (e.g. 1) to force natural redeliveries for the
# Scenario B duplicate-delivery demo.
SQS_VISIBILITY_TIMEOUT_SECONDS=30


# ============================================================================
# FAULT INJECTION — deliberately break things
#
# These exist so the failure proofs are re-runnable configuration, not a code
# edit you have to remember to undo. Both default to off.
# ============================================================================

# Phase 1 STOP condition. Sabotages the outbox INSERT by nulling a NOT NULL
# column, so POSTGRES rejects it — proving the orders INSERT is discarded too.
# Nulling a column rather than raising in Python matters: a Python raise would
# only prove Python stopped early.
#   BREAK_OUTBOX_INSERT=1 docker compose up -d order
BREAK_OUTBOX_INSERT=0

# Scenario A — "the single most important proof in the whole project".
# Exits the relay immediately AFTER publishing to SNS but BEFORE marking the
# row published. On restart the row still looks unpublished, gets published a
# second time, and all three consumers must no-op on the duplicate.
CRASH_AFTER_PUBLISH=0

# Phase 5's mirror image of the flag above. Exits the Notifications consumer
# between the Redis SET and the "email sent" side effect, so the key survives
# claiming a send that never happened — the redelivery is then correctly skipped
# as a duplicate and the notification is PERMANENTLY LOST.
#
# Run the two back to back and compare; they are the same class of crash with
# opposite outcomes, because the relay marks last and this consumer marks first:
#   CRASH_AFTER_PUBLISH=1  ->  nothing lost, event duplicated
#   CRASH_AFTER_MARK=1     ->  nothing duplicated, notification lost
#   CRASH_AFTER_MARK=1 docker compose up -d notifications
CRASH_AFTER_MARK=0


# ============================================================================
# LOGGING
# ============================================================================

# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Write to logs/<service>.log as well as the terminal.
# Terminal = windscreen (what is happening now). File = flight recorder
# (still there tomorrow, greppable, survives the container).
LOG_TO_FILE=1
LOG_DIR=logs

# Rotation, so a polling loop cannot fill your disk. When the file passes
# MAX_BYTES it becomes .log.1, a fresh one starts, and anything past
# BACKUP_COUNT is deleted. Total is capped at roughly
# MAX_BYTES x (BACKUP_COUNT + 1) — about 50 MB per service here.
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=4


# ============================================================================
# SHELL-ONLY  (not read by Python)
#
# Used by the commands in VERIFY-LOCAL-STACK.md and VERIFY-PHASE-1.md, e.g.
#   docker compose exec $PG_SVC psql -U $PG_USER -d $PG_DB
# They are compose SERVICE names, so they must match docker-compose.yml.
# ============================================================================

PG_SVC=postgres
REDIS_SVC=redis
LS_SVC=localstack
