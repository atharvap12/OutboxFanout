# OutboxFanout environment template.
#   cp .env.example .env
#   set -a; source .env; set +a        # .env does NOT auto-export to your shell
#
# Only PG_PASSWORD is required; every other value shown is the default that
# shared/config.py already uses. Listed here for discoverability.
#
# Three readers, easily confused:
#   your shell        — only after `set -a; source .env; set +a`
#   Docker Compose    — automatically, for ${VAR} in docker-compose.yml
#   Python in a container — never reads this file; sees only `environment:`


# --- Required ---------------------------------------------------------------

# Must match what the postgres container was CREATED with; changing it later
# does nothing until `docker compose down -v`.
PG_PASSWORD=mypassword


# --- Postgres ---------------------------------------------------------------

# Keep as localhost: this is the address for host-side tools. Compose
# overrides it to `postgres` for containers, where localhost means the
# container itself.
PG_HOST=localhost
PG_PORT=5432
PG_USER=myuser
PG_DB=mydatabase

# Optional full-URL override; wins over the parts above.
# DATABASE_URL=postgresql+psycopg://myuser:mypassword@localhost:5432/mydatabase

SQL_ECHO=0                      # log every SQL statement (noisy)


# --- Redis (Notifications consumer) -----------------------------------------

REDIS_HOST=localhost            # `redis` inside containers
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# 48h. A redelivery arriving later is treated as new; SQS retention defaults
# to 4 days, so possible but unlikely. Postgres consumers dedupe forever.
NOTIFY_DEDUP_TTL_SECONDS=172800


# --- AWS / LocalStack -------------------------------------------------------

# The AWS SDKs' own standard variable name, so boto3 and the AWS CLI honour it
# automatically. Containers use http://localstack:4566. Unset it entirely and
# the same code talks to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1

# Values are ignored by LocalStack, but boto3 signs requests before sending,
# so absent credentials fail locally.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test


# --- Resource names ---------------------------------------------------------
# Names, not ARNs/URLs: LocalStack forgets resources on restart, so
# identifiers change while names stay stable.

SNS_TOPIC_NAME=order-events
BILLING_QUEUE_NAME=billing-queue
SHIPPING_QUEUE_NAME=shipping-queue
NOTIFY_QUEUE_NAME=notify-queue


# --- Relay ------------------------------------------------------------------

RELAY_POLL_INTERVAL_SECONDS=2
RELAY_BATCH_SIZE=10             # larger batch = more rows republished on crash


# --- SQS consumers ----------------------------------------------------------

SQS_WAIT_TIME_SECONDS=20        # long polling; 20 is the SQS maximum
SQS_MAX_MESSAGES=10             # SQS maximum
# Set to 1 to force natural redeliveries for the Scenario B duplicate test.
SQS_VISIBILITY_TIMEOUT_SECONDS=30


# --- Fault injection --------------------------------------------------------

# Phase 1: nulls a NOT NULL column so Postgres rejects the outbox insert,
# proving the orders insert is discarded too.
BREAK_OUTBOX_INSERT=0

# Scenario A: exit after publishing to SNS but before marking the row
# published, so it is republished on restart and consumers must no-op.
CRASH_AFTER_PUBLISH=0

# Phase 5: exit between the Redis SET and the "email sent" side effect, so the
# key survives and the notification is lost. The opposite failure to
# CRASH_AFTER_PUBLISH above, which loses nothing and duplicates instead.
CRASH_AFTER_MARK=0


# --- Logging ----------------------------------------------------------------

LOG_LEVEL=INFO
LOG_TO_FILE=1
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760     # caps disk at ~50 MB/service with the backups
LOG_FILE_BACKUP_COUNT=4


# --- Shell-only (not read by Python) ----------------------------------------
# Used by the commands in VERIFY-*.md; must match docker-compose.yml service
# names.

PG_SVC=postgres
REDIS_SVC=redis
LS_SVC=localstack
