# Excluded from the build context: uploaded on every build otherwise, and
# .env would be baked into the image where anyone pulling it could read it.
# Configuration is injected at run time via `environment:`, not at build time.

.myenv/
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

.git/
.gitignore

.env
.env.*
!.env.example

*.pdf
*.md
!README.md

.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.idea/

logs/
